{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar SAM Controle",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall", "-g",
        "main.c", "usuarios.c", "clientes.c", "equipamentos.c", "servicos.c",
        "-o", "sam_controle"
      ],
      "options": { "cwd": "${workspaceFolder}/SamControle" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}